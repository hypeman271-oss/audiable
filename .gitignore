__pycache__/
*.pyc
.venv/
venv/
.env
.DS_Store
*.wav

# Piper voice models (large binaries, downloaded via scripts/get_voice.py)
voices/*.onnx
voices/*.onnx.json

# Playwright test artifacts
node_modules/
test-results/
playwright-report/
playwright/.cache/

# pip cache + PyInstaller build/dist — never commit these (multi-GB).
# Tracked accidentally in earlier commits; removed via `git rm -r --cached`.
.pip-cache/
.pyinstaller-build/
.pyinstaller-dist/

# Generic Python/PyInstaller artifacts (belt-and-suspenders).
build/
dist/
*.spec
*.egg-info/

# v225v4.29 (#707): Tauri updater signing keys. The PRIVATE key file
# never lands in git — losing or leaking it means the whole installed
# user base can't receive signed updates. Public key lives in
# tauri.conf.json (committed). See UPDATES.md for keypair generation.
src-tauri/.tauri/
*.key
*.key.pub
